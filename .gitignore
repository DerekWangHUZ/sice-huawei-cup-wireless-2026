# ==========================================
# 编译器与 IDE 临时文件
# ==========================================
.vscode/
.idea/
*.keil/
*.uvopt*
*.uvproj*

# ==========================================
# 嵌入式平台与构建缓存 (ESP-IDF / PlatformIO)
# ==========================================
.pio/
build/
sdkconfig.old

# ==========================================
# C / C++ 编译产物（任何 GCC / Clang 工程通用）
# ==========================================
*.o
*.d

# ==========================================
# Xilinx Vivado
# ==========================================
# .xpr 为 Vivado 工程状态快照，内部写死绝对路径，
# 换机器不可用，故不入库；工程由 rebuild.tcl 重建。
# 详见 docs/Vivado工程移植方案.md
*.xpr

# Vivado 运行缓存与实现产物
*.runs/
*.cache/
*.hw/
*.ip_user_files/
*.sim/
.Xil/
*.log
*.jou
*.str
*.bit.bin

# ==========================================
# Python 数据处理环境
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.ipynb_checkpoints/
venv/
.env

# ==========================================
# 操作系统与临时缓存
# ==========================================
.DS_Store
Thumbs.db
*.swp
*~

# ==========================================
# 超大媒体与压缩包 (不建议直接入库)
# ==========================================
*.mp4
*.avi
*.mov
*.zip
*.tar.gz
